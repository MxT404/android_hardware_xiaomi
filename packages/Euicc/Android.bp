phony {
    name: "XiaomiEuicc",
    enabled: select(soong_config_variable("veux", "disable_lineage_euicc"), {
        true: false,
        default: true,
    }),
    required: [
        "EuiccPolicy",
        "EuiccPolicyXiaomi",
    ],
}

runtime_resource_overlay {
    name: "EuiccPolicyXiaomi",
    product_specific: true,
}
